{
  "name": "@heyputer/shell",
  "version": "2.1.0",
  "description": "SSH-style shell access to your Puter files",
  "main": "index.js",
  "bin": {
    "puter-sh": "./bin/index.js",
    "psh": "./bin/index.js"
  },
  "preferGlobal": true,
  "type": "module",
  "scripts": {
    "start": "node bin/index.js",
    "test": "TZ=UTC vitest run tests/*",
    "test:watch": "TZ=UTC vitest --watch tests/*",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "coverage": "TZ=UTC vitest run --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "puter",
    "shell",
    "cloud"
  ],
  "author": "Ibrahim.H",
  "license": "MIT",
  "dependencies": {
    "@heyputer/puter.js": "^2.2.8",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "conf": "^12.0.0",
    "dotenv": "^16.4.7",
    "glob": "^11.0.0",
    "inquirer": "^9.2.12",
    "minimatch": "^10.0.1",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "auto-changelog": "^2.5.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeyPuter/puter-sh.git"
  },
  "bugs": {
    "url": "https://github.com/HeyPuter/puter-sh/issues"
  },
  "homepage": "https://github.com/HeyPuter/puter-sh"
}
